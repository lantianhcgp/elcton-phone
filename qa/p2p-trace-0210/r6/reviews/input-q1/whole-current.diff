+                peer = selected
+                var registering = true
+                deadline(15_000) { fail("接收器注册超时，未发送课表。") }
+                try {
+                    transport.register(selected, { raw -> main(gen) { onMessage(raw) } }, { scheduler.post {
+                        if (closed || gen != generation) {
