+            return subprocess.CompletedProcess([], code, text.encode(), b"")
+        gate.verify_one_test(result("Time: 0.3\n\nOK (1 test)\n"), "fixture")
+        for text, code in (("OK (2 tests)\n", 0), ("prefix OK (1 test)\n", 0),
