get.TextView" package="com.hcbiu.elcton" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[106,567][388,636]" /><node index="1" text="课表保存在两端应用本地；手机与手表同步不使用自建云服务。取件码导入只读访问课程表站点；设备能力、签名和运动健康授权决定是否可通信，不把 FIT3 作为型号白名单。" resource-id="" class="android.widget.TextView" package="com.hcbiu.elcton" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[106,673][974,818]" /><node index="2" text="" resource-id="" class="android.view.View" package="com.hcbiu.elcton" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[106,855][409,936]"><node index="0" text="0.2.10 · 测试构建" resource-id="" class="android.widget.TextView" package="com.hcbiu.elcton" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[138,873][377,918]" /></node><node index="3" text="Wear Engine 真实权限与其他运行时适配以验证报告为准。" resource-id="" class="android.widget.TextView" package="com.hcbiu.elcton" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[106,973][831,1013]" /></node><node index="2" text="" resource-id="" class="android.view.View" package="com.hcbiu.elcton" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,1108][1027,1584]"><nod