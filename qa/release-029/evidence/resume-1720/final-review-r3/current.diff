+        put(tool("start_publish", "Publish the current phone schedule through the same UI sync engine", props("confirm" to boolean(), "force" to boolean()), listOf("confirm")))
+        put(tool("abort", "Cancel current import/transfer, invalidate callbacks and stop waiting", JSONObject()))
+        put(tool("courses_read", "Read current phone courses, revision and pending import", JSONObject(), readOnly = true))
+        put(tool("courses_write", "Validate shared import preview; confirm=true replaces phone data with backup", props("document" to JSONObject().put("type", "object"), "confirm" to boolean(), "expected_revision" to integer()), listOf("document")))
+        put(tool("pickup_import", "Fetch a six-digit pickup code into the same shared import flow", props("pickup" to string().put("pattern", "^[0-9]{6}$"), "confirm" to boolean()), listOf("pickup"), openWorld = true))
+        put(tool("devices_list", "Read paired devices; refresh=true checks existing authorization without UI", props("refresh" to boolean()), readOnly = false))
+        put(tool("pairing_state", "Read the last observed pairing and authorization state, never guess", JSONObject(), readOnly = true))
+        put(tool("sync_state", "Read sync acceptance/completion and import preview state", JSONObject(), readOnly = true))
+    }
+
+    override fun validArguments(name: String, arguments: JSONObject): Boolean {
+        val keys = arguments.keys().asSequence().toSet()
+        fun optionalBoolean(key: String) = !arguments.has(key) || arguments.opt(key) is Boolean
+        return when (name) {
+            "sync_connect" -> keys == setOf("device_id") && arguments.opt("device_id") is String && arguments.getString("device_id").let { it.isNotBlank() && it.length <= 256 }
+            "sync_disconnect", "abort", "courses_read", "pairing_state", "sync_state" -> keys.isEmpty()
+            "start_import" -> keys.all { it == "confirm" } && optionalBoolean("confirm")
+            "start_publish" -> keys.all { it in setOf("confirm", "force") } && arguments.opt("confirm") is Boolean && optionalBoolean("force")
+            "courses_write" -> keys.all { it in setOf("document", "confirm", "expected_revision") } && arguments.opt("document") is JSONObject && optionalBoolean("confirm") && (!arguments.has("expected_revision") || exactInteger(arguments.opt("expected_revision"))?.let { it >= 0 } == true)
+            "pickup_import" -> keys.all { it in setOf("pickup", "confirm") } && arguments.opt("pickup") is String && Regex("[0-9]{6}").matches(arguments.getString("pickup")) && optionalBoolean("confirm")
+            "devices_list" -> keys.all { it == "refresh" } && optionalBoolean("refresh")
+            else -> true
+        }
+    }
+
+    override fun call(name: String, arguments: JSONObject): JSONObject {
+        if (name !in NAMES) return error("unknown_tool")
+        if (!validArguments(name, arguments)) return error("invalid_arguments")
+        return try {
+            val data = invoke(name, JSONObject(arguments.toString()))
+            result(data, data.has("error"))
+        } catch (_: Exception) { error("tool_failed") }
+    }
+
+    private fun string() = JSONObject().put("type", "string")
+    private fun boolean() = JSONObject().put("type", "boolean").put("default", false)
+    private fun integer() = JSONObject().put("type", "integer").put("minimum", 0).put("maximum", 9007199254740990L)
+    private fun props(vararg fields: Pair<String, JSONObject>) = JSONObject().apply { fields.forEach { put(it.first, it.second) } }
+    private fun tool(name: String, description: String, properties: JSONObject, required: List<String> = emptyList(), readOnly: Boolean = false, openWorld: Boolean = false) = JSONObject()
+        .put("name", name).put("description", description)
+        .put("inputSchema", JSONObject().put("type", "object").put("properties", properties).put("required", JSONArray(required)).put("additionalProperties", false))
+        .put("annotations", JSONObject().put("readOnlyHint", readOnly).put("destructiveHint", name in setOf("courses_write", "start_publish", "start_import", "pickup_import")).put("openWorldHint", openWorld))
+    private fun error(code: String) = result(JSONObject().put("error", code), true)
+    private fun result(data: JSONObject, failed: Boolean) = JSONObject().put("isError", failed).put("structuredContent", data)
+        .put("content", JSONArray().put(JSONObject().put("type", "text").put("text", data.toString())))
+    companion object {
+        val NAMES = setOf("sync_connect", "sync_disconnect", "start_import", "start_publish", "abort", "courses_read", "courses_write", "pickup_import", "devices_list", "pairing_state", "sync_state")
+    }
+}
diff --git a/app/src/main/java/com/hcbiu/elcton/PhoneRuntime.kt b/app/src/main/java/com/hcbiu/elcton/PhoneRuntime.kt
new file mode 100644
index 0000000..d1c5c71
--- /dev/null
+++ b/app/src/main/java/com/hcbiu/elcton/PhoneRuntime.kt
@@ -0,0 +1,103 @@
+package com.hcbiu.elcton
+
+import android.app.Activity
+import android.content.Context
+import android.os.Handler
+import android.os.Looper
+import org.json.JSONObject
+import java.util.concurrent.Executors
+
+/** Application scope owns the ONLY engine/store; UI is an observer, not the transport owner. */
+class PhoneRuntime(context: Context) {
+    private val app = context.applicationContext as ElctonApplication
+    private val main = Handler(Looper.getMainLooper())
+    private val dispatcher = MainThreadActions({ block -> main.post { block() } }, { Looper.myLooper() == Looper.getMainLooper() })
+    private val listeners = LinkedHashSet<() -> Unit>()
+    val schedule = PhoneSchedule(ScheduleStore(app)) { notifyObservers() }
+    private val adapter = WearProbe(app, { notifyObservers() }, { raw, revision -> actions.receiveImport(raw, revision) })
+    val actions: PhoneActions = PhoneActions(adapter.engine, schedule)
+    val sync get() = adapter.engine.state
+    private val network = Executors.newSingleThreadExecutor { task -> Thread(task, "elcton-pickup").apply { isDaemon = true } }
+    private var pickupGeneration = 0L
+    private var pickup: PickupClient? = null
+    private var pickupBusy = false
+    private var pickupError: String? = null
+
+    fun observe(listener: () -> Unit) { listeners.add(listener); listener() }
+    fun unobserve(listener: () -> Unit) { listeners.remove(listener) }
+    private fun notifyObservers() { listeners.toList().forEach { it() } }
+    fun scan(activity: Activity? = null): Boolean = adapter.authorizeAndScan(activity != null, activity)
+    fun connect(deviceId: String): Boolean = !pickupBusy && actions.connect(deviceId)
+    fun publish(confirm: Boolean, force: Boolean = false) = !pickupBusy && actions.publish(confirm, force)
+    fun startImport(confirm: Boolean = false) = !pickupBusy && actions.startImport(confirm)
+    fun importDocument(raw: String, confirm: Boolean = false): Boolean = !pickupBusy && actions.importDocument(raw, confirm)
+    fun save(book: ScheduleBook) = !pickupBusy && schedule.save(book)
+    fun cancelAll() {
+        dispatcher.invalidate()
+        pickupGeneration++
+        pickup?.cancel(); pickup = null; pickupBusy = false; pickupError = null
+        actions.abort()
+        notifyObservers()
+    }
+    fun disconnect() { cancelAll() }
+    fun onBackground() {
+        if (!McpKeepAlive.active) cancelAll()
+        adapter.clearActivity()
+    }
+
+    fun pickupImport(code: String, confirm: Boolean): Boolean {
+        if (pickupBusy || sync.busy || schedule.state.loadError != null) return false
+        require(Regex("[0-9]{6}").matches(code)) { "取件码必须是六位数字" }
+        val generation = ++pickupGeneration
+        val client = PickupClient(); pickup = client; pickupBusy = true; pickupError = null
+        val revision = schedule.state.book.revision
+        notifyObservers()
+        network.execute {
+            val fetched = runCatching { client.fetch(code) }
+            main.post {
+                if (generation != pickupGeneration) return@post
+                pickupBusy = false; pickup = null
+                if (schedule.state.book.revision != revision || sync.busy) {
+                    pickupError = "导入期间课表或同步状态已改变，请重新检查"
+                } else fetched.onSuccess {
+                    if (!actions.importDocument(it, confirm)) pickupError = schedule.state.notice
+                }.onFailure { error -> pickupError = UserFacingError.validation(error.message) }
+                notifyObservers()
+            }
+        }
+        return true
+    }
+
+    /** HTTP worker marshals bounded work to the same Android main-thread state as UI/SDK. */
+    fun mcp(name: String, args: JSONObject): JSONObject = dispatcher.invoke {
+        if (!McpKeepAlive.enabled(app)) JSONObject().put("error", "mcp_session_stopped")
+        else runAction(name, args)
+    }
+    private fun stateJson() = actions.stateJson().put("pickup_busy", pickupBusy).put("pickup_error", pickupError ?: JSONObject.NULL)
+    private fun accepted(value: Boolean) = stateJson().put("accepted", value).put("state", if (value) "pending" else "rejected")
+        .apply { if (!value) put("error", "not_ready_busy_or_confirmation_required") }
+
+    private fun runAction(name: String, args: JSONObject): JSONObject = when (name) {
+        "sync_connect" -> accepted(connect(args.getString("device_id")))
+        "sync_disconnect" -> { disconnect(); stateJson().put("accepted", true).put("state", "cancelled") }
+        "start_import" -> accepted(startImport(args.optBoolean("confirm", false)))
+        "start_publish" -> accepted(publish(args.getBoolean("confirm"), args.optBoolean("force", false)))
+        "abort" -> { cancelAll(); stateJson().put("accepted", true).put("state", "cancelled") }
+        "courses_read" -> actions.coursesJson()
+        "courses_write" -> {
+            if (args.has("expected_revision") && args.getLong("expected_revision") != schedule.state.book.revision) JSONObject().put("error", "stale_revision")
+            else {
+                val ok = importDocument(args.getJSONObject("document").toString(), args.optBoolean("confirm", false))
+                actions.coursesJson().put("accepted", ok).put("state", if (!ok) "rejected" else if (args.optBoolean("confirm", false)) "saved" else "preview")
+                    .apply { if (!ok) put("error", "validation_failed_or_busy") }
+            }
+        }
+        "pickup_import" -> accepted(pickupImport(args.getString("pickup"), args.optBoolean("confirm", false)))
+        "devices_list" -> actions.devicesJson().apply {
+            if (args.optBoolean("refresh", false)) put("refresh_accepted", scan()).put("state", "pending")
+        }
+        "pairing_state" -> stateJson().put("devices", actions.devicesJson().getJSONArray("devices"))
+        "sync_state" -> stateJson()
+        else -> JSONObject().put("error", "unknown_tool")
+    }
+}
diff --git a/app/src/main/java/com/hcbiu/elcton/PhoneSchedule.kt b/app/src/main/java/com/hcbiu/elcton/PhoneSchedule.kt
new file mode 100644
